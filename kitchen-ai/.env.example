# Copy this file to ".env" and fill in the two values from Supabase
# (Supabase dashboard -> Project Settings -> API).
# These two are SAFE to be in the app: the "anon"/publishable key can only do
# what the database security rules allow. Never put the service_role key or
# the Anthropic key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
