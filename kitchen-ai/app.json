{
  "expo": {
    "name": "Kitchen AI",
    "slug": "kitchen-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kitchenai.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kitchen AI uses your camera to photograph your fridge so it can suggest meals.",
        "NSPhotoLibraryUsageDescription": "Kitchen AI lets you pick a fridge photo from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kitchen AI uses your camera to photograph your fridge so it can suggest meals.",
          "photosPermission": "Kitchen AI lets you pick a fridge photo from your library."
        }
      ]
    ],
    "scheme": "kitchenai",
    "experiments": {
      "typedRoutes": true
    }
  }
}